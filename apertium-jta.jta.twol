Sets

Consonant = க ங ச ஞ	ட ண த ந ப ம ய ர ல வ	ழ ள ற ன ;
ConsonantR = க ங ச ஞ	ட ண த ந ப ம ய ர ல வ	ழ ள ன ;
Mellinam = ங ஞ ண ந ம ன;
Vallinam = க ச ட த ப ற;
Idaiyinam = ய ர ல வ ழ ள;

RemConsonant = Mellinam ல ;

Vowel = அ ஆ இ ஈ உ ஊ எ ஏ ஐ ஒ ஓ ஔ ஃ ;
VowWithSym = ஆ இ ஈ உ ஊ எ ஏ ஐ ஒ ஓ ஔ ;
VowSym = ா  ி  ீ  ு  ூ  ெ  ே  ை  ொ  ோ  ௌ ;
ShortVowSym = ி  ு  ெ  ை  ொ;
LongVowSym =  ா  ீ  ூ  ே  ோ  ௌ;
SuffixVowels = %{AIE%} %{A%} %{AA%} %{I%} %{II%} %{U%} %{UU%} %{E%} %{EE%} %{AI%} %{O%} %{OO%} %{AU%} %{Irefr%} ;
SuffixVowelsA = %{AIE%} %{AA%} %{I%} %{II%} %{U%} %{UU%} %{E%} %{EE%} %{AI%} %{O%} %{OO%} %{AU%} %{Irefr%} ;
SuffixVowelsIr = %{AIE%} %{AA%} %{I%} %{II%} %{U%} %{UU%} %{E%} %{EE%} %{AI%} %{O%} %{OO%} %{AU%} ;
SuffixVowelsU = %{AIE%} %{A%} %{AA%} %{I%} %{II%} %{UU%} %{E%} %{EE%} %{AI%} %{O%} %{OO%} %{AU%} %{Irefr%} ;
SuffixVowelsI = %{AIE%} %{A%} %{AA%} %{II%} %{U%} %{UU%} %{E%} %{EE%} %{AI%} %{O%} %{OO%} %{AU%} ;
SuffixVowelsIA = %{AIE%} %{AA%} %{II%} %{U%} %{UU%} %{E%} %{EE%} %{AI%} %{O%} %{OO%} %{AU%} %{Irefr%} ;
VowelRight = ShortVowSym LongVowSym ;

Rules 

! Pulli
"Removing Pulli"
%{Pul%}:0 <=> :Consonant _ %>: [ SuffixVowels: | %{AAm%}: | %{Um%}: | %{OOm%}: ] ;
              %{M%}: _ %>: [ %{AAm%}: | %{Um%}: | %{OOm%}: ] ;
              _ %>: %{UA%}: ;
              %{NR%}: _ %>: %{R%}: %{Pul%}: ;
              %{PLR%}: _ %>: %{R%}: ;
              %{PL%}: _ %>: %{T%}: ;
              %{PL%}: _ %>: %{AA%}: .#. ;
              %{TH%}: _ %>: [ SuffixVowels: | %{AAm%}: | %{Um%}: | %{OOm%}: ] ;
              [ %{NP%}: | %{NR%}: | %{NK%}: | %{RP%}: ] _ %>: %{I%}: :0 %{Pul%}: %{R%}: ;
                except 
                ப: ல: _ %>: ;
                %{M%}: _ %>: SuffixVowels: ;

"Keeping Pulli"
%{Pul%}:் <=> _ .#. ;
              _ %>: :RemConsonant ;
              _ %>: %{K%}: ;
              %{K%}: _ %{K%}: ;
              %{N%}: _ %{R%}: ;
              %{T%}: _ %{T%}: ;
              :ந _ :த ;
              :த _ :த ;
              :ச _ :ச ;
              %{P%}: _ %{P%}: ;
              [ SuffixVowels: | %{Ul%}: ] [ %{Yy%}: | %{Y%}: | %{Ln%}: | %{LN%}: | %{LLn%}: | %{LT%}: | :ண | :ர ] _ %>: [  %{RR%}: | %{P%}: | %{T%}: | :த | :ச | :வ | :ன ] ;
              [ SuffixVowels: | %{Ul%}: ] [ %{Yy%}: | %{Ln%}: | %{LN%}: | %{LLn%}: | :ண | :ர ] _ 0: %>: SuffixVowels: ;              
              %{M%}: _ 0: %>: SuffixVowels: ;
              [ %{NP%}: | %{NR%}: | %{NK%}: | %{RP%}: ] :0 %>: %{I%}: :0 _ %{R%}: ;
              %{Y%}: _ 0: %>: %{U%}: ;
              %{T%}: _ 0: %>: [ SuffixVowelsA: | %{AAv%}: ] ;
              %{T%}: _ 0: (%{U%}:) %>: %{A%}: :Consonant ;
              %{NP%}: _ %>: %{T%}: ;

"Adding Pulli"
0:Vy <=> %{AN%}: _ %>: %{K%}: ;
         %{T%}: _ 0: %{U%}: %>: SuffixVowelsA: ;
         %{T%}: _ 0: (%{U%}:) %>: %{A%}: :Consonant ;
         %{RR%}: _ 0: %{U%}: %>: SuffixVowels: ;
         %{AA%}: %>: 0: _ %{K%}: ;
         [ %{T%}: | %{RR%}: ] _ %{U%}: %>: %{TR%}: ;
         [ %{Al%}: | %{Il%}: | %{Ul%}: | %{El%}: ] 0: _ 0: %>: %{Al%}: ;
         SuffixVowels: %>: 0: _ %{Kk%}: ;
         where Vy in ( ் ) ;

! -m ending
"Keep M to m if end of word"
%{M%}:ம <=> _ %{Pul%}: .#. ;
             _ %{Pul%}: %>: [ %{AAm%}: | %{Um%}: | %{OOm%}: ] ;

"Transform underlying M to T when vowel"
%{M%}:த <=> _ %{Pul%}: 0: %>: SuffixVowels: ;

"Insert a second T"
0:த <=> %{M%}: %{Pul%}: _ %>: SuffixVowels: ;

"Change to RR"
%{TR%}:ற <=> %{RR%}: :Vy %{U%}: %>: _ ;
              where Vy in ( ் ) ;

"Change to T"
%{TR%}:ட <=> %{T%}: :Vy %{U%}: %>: _ ;
              where Vy in ( ் ) ;

! N addition
"Starting with K"
%{AN%}:ங <=> _ :Vy %>: %{K%}: ;
              where Vy in ( ் ) ; 

! Accusative case
"Removing AA when faced with SuffixVowels"
%{AA%}:0 <=> _ %>: SuffixVowelsIr: .#. ;
            :வ %>: _ ;

! Genitive case
"Removing I for nouns ending in N or R"
%{I%}:0 <=> [ %{NP%}: | %{RP%}: | %{NR%}: | %{NK%}: ] %{Pul%}: %>: _ %{N%}: %{Pul%}: %{R%}: ;

"Removing N for nouns ending in N or R"
%{N%}:0 <=> [ %{NP%}: | %{RP%}: | %{NR%}: | %{NK%}: ] %{Pul%}: %>: %{I%}: _ %{Pul%}: %{R%}: ;

! Referential case
"Removing I when Referential and noun ends in AA"
%{Irefr%}:0 <=> %{AA%}: %>: _ ;
                [ %{El%}: | %{Ul%}: ] %{NP%}: %{Pul%}: %>: 0: _ ;

! Word endings 
"Inserting ய"
0:ய <=> [ %{AI%}: | %{I%}: | %{II%}: | %{EE%}: | %{E%}: | %{AIE%}: ] (%{AN%}:) _ %>: [ :VowelRight | %{Irefr%}: | %{Um%}: | %{AAm%}: | %{OOm%}: | %{A%}: ] ;
         %{AA%}: _ %>: %{I%}: ;
         %{Yy%}: %{Pul%}: _ %>: SuffixVowels: ;

"Inserting வ"
0:வ <=> %{AA%}: _ %>: SuffixVowelsI: ;
         %{A%}: _ %>: SuffixVowelsA: ;
         [ %{Al%}: | %{Il%}: | %{Ul%}: | %{El%}: ] _ 0: 0: %>: %{Al%}: ;
         [ %{Al%}: | %{Il%}: | %{Ul%}: | %{El%}: ] 0: 0: _ %>: %{Al%}: ;

"Insert a second RR"
0:ற <=> %{RR%}: :Vy _ %{U%}: %>: SuffixVowels: ;
         where Vy in ( ் ) ;

"Insert a second T"
0:ட <=> %{T%}: :Vy _ (%{U%}:) %>: [ SuffixVowelsA: | %{AAv%}: ] ;
        %{T%}: :Vy _ (%{U%}:) %>: %{A%}: :Consonant ;
              where Vy in ( ் ) ;

"Insert a second L"
0:ல <=> [ %{L%}: | %{Ln%}: | %{LLn%}: ] :Vy _ %>: SuffixVowels: ;
         where Vy in ( ் ) ;

"Inserting ள"
0:ள <=> %{LN%}: %{Pul%}: _ %>: SuffixVowels: ;

"Inserting ண"
0:ண <=> %{NN%}: %{Pul%}: _ %>: %{U%}: ;

"Inserting க"
0:க <=> %{AA%}: %>: _ 0: %{K%}: ;
         SuffixVowels: %>: _ 0: %{Kk%}: ;

"Inserting ன"
0:ன <=> [ %{El%}: | %{Ul%}: ] %{NP%}: %{Pul%}: %>: _ SuffixVowelsIA: ;

"Dropping Al"
%{Al%}:0 <=> [ %{Al%}: | %{Il%}: | %{Ul%}: | %{El%}: ] 0: 0: 0: %>: _ ;

"AIE drops before Y"
%{AIE%}:0 <=> _ :ய %>: ;

"Removing  ு"
%{U%}:0 <=> _ %>: SuffixVowelsU: ;
            SuffixVowelsU: %>: _ ;
            _ %>: [ %{U%}: | %{Um%}: | %{AAm%}: | %{OOm%}: ] ;
            [ %{T%}: | %{RR%}: ] 0: _ %>: %{TR%}: ;

"Removing UA"
%{UA%}:0 <=> %{AA%}: %>: _ ;

"Starting with K"
%{M%}:ங <=> _ %{Pul%}: %>: %{K%}: ;

"Starting with K"
%{N%}:ங <=> _ %{Pul%}: %>: %{K%}: ;

"Starting with K"
%{NK%}:ர <=> _ %{Pul%}: %>: %{K%}: ;

"Starting with K"
%{NP%}:ங <=> _ %{Pul%}: %>: %{K%}: ;

"Starting with K"
%{NR%}:ங <=> _ %{Pul%}: %>: %{K%}: ;

"Starting with AA or T"
%{PL%}:0 <=> _ %{Pul%}: %>: %{AA%}: .#. ;
             _ %{Pul%}: %>: %{T%}: ;

"Starting with T"
%{LN%}:ண <=> _ %{Pul%}: %>: %{T%}: ;

"Starting with T"
%{LT%}:ட <=> _ %{Pul%}: %>: :Consonant ;

"Starting with R or N"
%{Ln%}:ன <=> _ %{Pul%}: %>: [ %{RR%}: | :ன ] ;

"Starting with N"
%{LLn%}:ன <=> _ %{Pul%}: %>: %{Nn%}: ;

"Starting with K"
%{Ln%}:ற <=> _ %{Pul%}: %>: [ %{K%}: | %{P%}: ] ;

"Starting with R"
%{NR%}:0 <=> _ %{Pul%}: %>: %{R%}: %{Pul%}: ;

"Starting with R"
%{PLR%}:0 <=> _ %{Pul%}: %>: %{R%}: ;

"Starting with K"
%{PLR%}:ங <=> _ %{Pul%}: %>: %{K%}: ;

"Starting with C"
%{Y%}:0 <=> _ %>: %{C%}: ;

"Ending with nothing or genitive"
%{NR%}:ன <=> _ %{Pul%}: .#. ;
              _ %{Pul%}: %>: :0 :0 %{Pul%}: %{R%}: ;
              _ %{Pul%}: %>: SuffixVowels: ;

"Ending with nothing"
%{PLR%}:ள <=> _ %{Pul%}: .#. ;

! Irregular verb forms
"Inserting Ru/Ra for thaa, vaa"
0:ர <=> [ :த | :வ ] %{AAIrr%}: _ 0: %>: [ %{K%}: | :வ ] ;
        [ :த | :வ ] %{AAIrr%}: _ %>: SuffixVowels: ;
        [ :த | :வ ] %{AAIrr%}: _ %>: %{UIrr%}: ;

"Inserting rU for thaa, vaa"
0:Vy <=> [ :த | :வ ] %{AAIrr%}: 0: _ %>: [ %{K%}: | :வ ] ;
         where Vy in ( ு ) ;

"Dropping AA for thaa, vaa"
%{AAIrr%}:0 <=> [ :த | :வ ] _ (0: 0:) %>: :ConsonantR ;
             [ :த | :வ ] _ 0: %>: [ SuffixVowels: | %{UIrr%}: ] ;

"Dropping AA for thaa, vaa"
%{AAIrr%}:Vy <=> [ :த | :வ ] _ %>: :ற ;
                 [ :த | :வ ] _ .#. ;  
                 where Vy in ( ா ) ;

"Dropping irregular U after OO for poo"
%{UIrr%}:0 <=> %{OO%}: %>: _ ;


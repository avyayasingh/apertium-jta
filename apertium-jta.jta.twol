Sets

Consonant = க ங ச ஞ	ட ண த ந ப ம ய ர ல வ	ழ ள ற ன ;
Mellinam = ங ஞ ண ந ம ன;
Vallinam = க ச ட த ப ற;
Idaiyinam = ய ர ல வ ழ ள;
ConsonantNOTTM = க ங ச ஞ	ட ண ந ய ப ர ல வ	ழ ள ற ன ;

RemConsonant = Mellinam ல ;

Vowel = அ ஆ இ ஈ உ ஊ எ ஏ ஐ ஒ ஓ ஔ ஃ ;
VowWithSym = ஆ இ ஈ உ ஊ எ ஏ ஐ ஒ ஓ ஔ ;
VowSym = ா  ி  ீ  ு  ூ  ெ  ே  ை  ொ  ோ  ௌ ;
ShortVowSym = ி  ு  ெ  ை  ொ;
LongVowSym =  ா  ீ  ூ  ே  ோ  ௌ;
SuffixVowels = %{A%} %{AA%} %{I%} %{II%} %{U%} %{UU%} %{E%} %{EE%} %{AI%} %{O%} %{OO%} %{AU%} %{Irefr%} ;
SuffixVowelsIr = %{AA%} %{I%} %{II%} %{U%} %{UU%} %{E%} %{EE%} %{AI%} %{O%} %{OO%} %{AU%} ;
SuffixVowelsU = %{A%} %{AA%} %{I%} %{II%} %{UU%} %{E%} %{EE%} %{AI%} %{O%} %{OO%} %{AU%} %{Irefr%} ;
SuffixVowelsI = %{A%} %{AA%} %{II%} %{U%} %{UU%} %{E%} %{EE%} %{AI%} %{O%} %{OO%} %{AU%} %{Irefr%} ;
VowelRight = ShortVowSym LongVowSym ;

Rules 

! Pulli
"Removing Pulli"
%{Pul%}:0 <=> :ConsonantNOTTM _ %>: [ SuffixVowels: | %{AAm%}: | %{Um%}: ] ;
              %{M%}: _ %>: [ %{AAm%}: | %{Um%}: ] ;
              %{NR%}: _ %>: %{R%}: %{Pul%}: ;
              %{PLR%}: _ %>: %{R%}: ;
              %{TH%}: _ %>: [ SuffixVowels: | %{AAm%}: | %{Um%}: ] ;
              [ %{NP%}: | %{NR%}: ] _ %>: %{I%}: :0 %{Pul%}: %{R%}: %{EE%}: ;  
                except 
                ப: ல: _ %>: ;
                %{M%}: _ %>: SuffixVowels: ;

"Keeping Pulli"
%{Pul%}:் <=> _ .#. ;
              _ %>: :RemConsonant ;
              _ %>: %{K%}: ;
              %{N%}: _ %{R%}: ;
              %{M%}: _ (0:) %>: SuffixVowels: ;
              [ %{NP%}: | %{NR%}: ] :0 %>: %{I%}: :0 _ %{R%}: %{EE%}: ;
              %{Y%}: _ 0: %>: %{U%}: ;
              %{NP%}: _ %>: 0: [ %{UN%}: | %{TK%}: ] ;

"Adding Pulli"
0:Vy <=> %{AN%}: _ %>: %{K%}: ;
         %{T%}: _ (0:) %{U%}: %>: SuffixVowels: ;
         %{RR%}: _ (0:) %{U%}: %>: SuffixVowels: ;
         %{AA%}: %>: 0: _ %{K%}: ;
         where Vy in ( ் ) ;

! -m ending
"Keep M to m if end of word"
%{M%}:ம <=> _ %{Pul%}: .#. ;

"Transform underlying M to T when vowel"
%{M%}:த <=> _ %{Pul%}: (0:) %>: SuffixVowels: ;

"Insert a second T"
0:த <=> %{M%}: %{Pul%}: _ %>: SuffixVowels: ;

! -rr ending
"Insert a second RR"
0:ற <=> %{RR%}: :Vy _ %{U%}: %>: SuffixVowels: ;
              where Vy in ( ் ) ;

! -tu ending
"Insert a second T"
0:ட <=> %{T%}: :Vy _ %{U%}: %>: SuffixVowels: ;
              where Vy in ( ் ) ;

! -l ending irregular
"Insert a second L"
0:ல <=> %{L%}: :Vy _ %>: SuffixVowels: ;
              where Vy in ( ் ) ;
! N addition
"Starting with K"
%{AN%}:ங <=> _ :Vy %>: %{K%}: ;
              where Vy in ( ் ) ; 

! Accusative case
"Removing AA when faced with SuffixVowels"
%{AA%}:0 <=> _ %>: SuffixVowelsIr: .#. ;
            :வ %>: _ ;

! Genitive case
"Removing I for nouns ending in N or R"
%{I%}:0 <=> [ %{NP%}: | %{RP%}: | %{NR%}: ] %{Pul%}: %>: _ %{N%}: %{Pul%}: %{R%}: %{EE%}: ;

"Removing N for nouns ending in N or R"
%{N%}:0 <=> [ %{NP%}: | %{RP%}: | %{NR%}: ] %{Pul%}: %>: %{I%}: _ %{Pul%}: %{R%}: %{EE%}: ;

! Referential case
"Removing I when Referential and noun ends in AA"
%{Irefr%}:0 <=> %{AA%}: %>: _ ;

! Noun endings 
"Inserting ய"
0:ய <=> [ %{AI%}: | %{I%}: | %{II%}: | %{EE%}: ] (%{AN%}:) _ %>: [ :VowelRight | %{Um%}: | %{AAm%}: ] ;
         %{AA%}: _ %>: %{I%}: ;
         %{Y%}: %{Pul%}: _ %>: %{U%}: ;

"Inserting வ"
0:வ <=> [ %{A%}: | %{AA%}: ] _ %>: SuffixVowelsI: ;

"Inserting க"
0:க <=> %{AA%}: %>: _ 0: %{K%}: ;
        %{NP%}: %{Pul%}: %>: _ %{TK%}: ;

"Inserting ன"
0:ன <=> %{NP%}: %{Pul%}: %>: _ %{UN%}: ;

"EE drops before Y"
%{EE%}:0 <=> _ :ய %>: ;

"A changes to AA after Y"
%{A%}:ா <=> :ய %>: _ ;

"Removing  ு"
%{U%}:0 <=> _ %>: SuffixVowelsU: ;
            SuffixVowelsU: %>: _ ;
            _ %>: [ %{U%}: | %{Um%}: ] ;

"Starting with K"
%{M%}:ங <=> _ %{Pul%}: %>: %{K%}: ;

"Starting with K"
%{N%}:ங <=> _ %{Pul%}: %>: %{K%}: ;

"Starting with K"
%{NP%}:ங <=> _ %{Pul%}: %>: %{K%}: ;
              _ %{Pul%}: %>: 0: %{TK%}: ;

"Starting with K"
%{NR%}:ங <=> _ %{Pul%}: %>: %{K%}: ;

"Starting with AA"
%{PL%}:0 <=> _ %{Pul%}: %>: [ %{AA%}: | %{AAm%}: ] ;

"Starting with R"
%{NR%}:0 <=> _ %{Pul%}: %>: %{R%}: %{Pul%}: ;

"Starting with R"
%{PLR%}:0 <=> _ %{Pul%}: %>: %{R%}: ;

"Starting with K"
%{PLR%}:ங <=> _ %{Pul%}: %>: %{K%}: ;

"Starting with C"
%{Y%}:0 <=> _ %>: %{C%}: ;

"Ending with nothing or genitive"
%{NR%}:ன <=> _ %{Pul%}: .#. ;
              _ %{Pul%}: %>: :0 :0 %{Pul%}: %{R%}: %{EE%}: ;

"Ending with nothing"
%{PLR%}:ள <=> _ %{Pul%}: .#. ;


<p3><nh><pl>:>த{U}>கள{Pul}[Nor,NHumE2]     # 'tukal'     plural         (non-human var)            Dir/LR
<p3><nh><pl>:>{UA}த{U}>கள{Pul}[Nor,NHum]   # 'utukal'    plural         (non-human var)            Dir/LR

################## TENSE
LEXICON TenseInfix
# Class-wise distribution
# Past
<past>:>த[Class1a]                                                                 # 'th'
<past>:>{T}[Class1b]                                                                # 't'
<past>:>{RR}[Class1c]                                                               # 'r'
<past>:>ந{Pul}த[Class2]                                                            # 'nth'
<past>:>ஞ{Pul}ச[Class2]                                                            # 'njc'       Dir/LR
<past>:>{I}ன[Class3]                                                               # 'in'
<past>:>ன[Class3Irr]                                                               # 'n'
<past>:>ச{Pul}ச[Class3Irr]                                                         # 'cc'        Dir/LR
<past>:>{TR}[Class4]                                                                # 'r'/'t'
<past>:>{RR}[Class5a]                                                               # 'r'
<past>:>{Nn}[Class5b]                                                               # 'n'
<past>:>{T}[Class5c]                                                                # 't'
<past>:>{T}[Class5d]                                                                # 't'
<past>:>{RR}[Class5e]                                                               # 'r'
<past>:>{RR}[Class5f]                                                               # 'r'
<past>:>{T}[Class5f]                                                                # 't'         Dir/LR
<past>:>த{Pul}த[Class6]                                                            # 'thth'
<past>:>ச{Pul}ச[Class6]                                                            # 'cc'        Dir/LR
<past>:>ந{Pul}த[Class7]                                                            # 'nth'
<past>:>ஞ{Pul}ச[Class7]                                                           # 'njc'        Dir/LR

# Present
## weak form
<pres>:>{K}{I}ற[Class1a,Class1b,Class1c,Class2,Class3,Class3Irr,Class4]            # 'kir'
### variants
<pres>:>{K}{I}ன்ற[Class1a,Class1b,Class1c,Class2,Class3,Class3Irr,Class4]          # 'kinr'       Dir/LR
<pres>:>{I}ற[Class1a,Class1b,Class1c,Class2,Class3,Class3Irr,Class4]               # 'ir'         Dir/LR
<pres>:>{U}ற[Class1a,Class1b,Class1c,Class2,Class3,Class3Irr,Class4]               # 'ur'         Dir/LR
<pres>:>ற[Class1a,Class1b,Class1c,Class2,Class3,Class3Irr,Class4]                  # 'r'          Dir/LR
## irregular class
<pres>:>{K}{I}ற[Class5a,Class5b,Class5c,Class5d,Class5e,Class5f]                   # 'kir'
### variants
<pres>:>{K}{I}ன்ற[Class5a,Class5b,Class5c,Class5d,Class5e,Class5f]                 # 'kinr'       Dir/LR
<pres>:>{I}ற[Class5a,Class5b,Class5c,Class5d,Class5e,Class5f]                      # 'ir'         Dir/LR
<pres>:>{U}ற[Class5a,Class5b,Class5c,Class5d,Class5e,Class5f]                      # 'ur'         Dir/LR
<pres>:>ற[Class5a,Class5b,Class5c,Class5d,Class5e,Class5f]                         # 'r'          Dir/LR
## strong form
<pres>:>{K}{Pul}{K}{I}ற[Class6,Class7]                                             # 'kkir'
### variants
<pres>:>{K}{Pul}{K}{I}ன்ற[Class6,Class7]                                           # 'kkinr'     Dir/LR
<pres>:>{I}ற[Class6,Class7]                                                        # 'ir'        Dir/LR
<pres>:>{U}ற[Class6,Class7]                                                        # 'ur'        Dir/LR
<pres>:>ற[Class6,Class7]                                                           # 'r'         Dir/LR

## irregulars
<pres><neg>:[E]                                                                     # null
<pres>:[NHum,P3EP]                                                                  # null
<pres>:>{K}[W]                                                                      # 'k'         Dir/LR
<pres>:>{K}{Pul}{K}[S]                                                              # 'kk'        Dir/LR

# Future
## weak form
<fut>:>வ[Class1a,Class1b,Class1c,Class2,Class3,Class3Irr,Class4]                   # 'v'
## irregular class
<fut>:>{P}[Class5a]                                                                 # 'p'
<fut>:>வ[Class5b]                                                                  # 'v'
<fut>:>{P}[Class5c]                                                                 # 'p'
<fut>:>{U}வ[Class5c]                                                               # 'uv'        Dir/LR
<fut>:>{P}[Class5d]                                                                 # 'p'
<fut>:>{P}[Class5e]                                                                 # 'p'
<fut>:>{P}[Class5f]                                                                 # 'p'
## strong form
<fut>:>{P}{Pul}{P}[Class6,Class7]                                                   # 'pp'

## irregulars
<fut>:[NHumE2]                                                                      # null
<fut>:>{UA}ம{Pul}[NHumE]                                                           # 'um'

################## CONDITIONALS
LEXICON Conditionals
# take the class-based past infix and attach '-aal'
<cni>:>த>{AA}ல{Pul}[Class1a]                                                       # 'thaal'
<cni>:>{T}>{AA}ல{Pul}[Class1b]                                                      # 'taal'
<cni>:>{RR}>{AA}ல{Pul}[Class1c]                                                     # 'raal'
<cni>:>ந{Pul}த>{AA}ல{Pul}[Class2]                                                  # 'nthaal'
<cni>:>ஞ{Pul}ச>{AA}ல{Pul}[Class2]                                                  # 'njcaal'           Dir/LR
<cni>:>{I}ன>{AA}ல{Pul}[Class3]                                                     # 'inaal'
<cni>:>ன>{AA}ல{Pul}[Class3Irr]                                                     # 'naal'
<cni>:>ச{Pul}ச>{AA}ல{Pul}[Class3Irr]                                               # 'ccaal'            Dir/LR
<cni>:>{TR}>{AA}ல{Pul}[Class4]                                                      # 'raal'/'taal'
<cni>:>{RR}>{AA}ல{Pul}[Class5a]                                                     # 'raal'
<cni>:>{Nn}>{AA}ல{Pul}[Class5b]                                                     # 'naal'
<cni>:>{T}>{AA}ல{Pul}[Class5c]                                                      # 'taal'
<cni>:>{T}>{AA}ல{Pul}[Class5d]                                                      # 'taal'
<cni>:>{RR}>{AA}ல{Pul}[Class5e]                                                     # 'raal'
<cni>:>{RR}>{AA}ல{Pul}[Class5f]                                                     # 'raal'
<cni>:>{T}>{AA}ல{Pul}[Class5f]                                                      # 'taal'             Dir/LR
<cni>:>த{Pul}த>{AA}ல{Pul}[Class6]                                                  # 'ththaal'
<cni>:>ச{Pul}ச>{AA}ல{Pul}[Class6]                                                  # 'ccaal'            Dir/LR
<cni>:>ந{Pul}த>{AA}ல{Pul}[Class7]                                                  # 'nthaal'
<cni>:>ஞ{Pul}ச>{AA}ல{Pul}[Class7]                                                  # 'njcaal'           Dir/LR

################## CONCESSIVE
LEXICON Concessive
<concess>:>{AAv}ல>{U}ம்                   # 'aalum'        even if
<concess>:>{U}ம்[PART]                     # 'um'           even if

########################### PRONOUNS
################## HUMAN RADICAL
LEXICON HumanRadical
# Added to indefinite pronouns
# human
<h>:>{A}ர{Pul}[Hum]           # 'ar'
# non-human
<nh>:>{A}த்{TH}{Pul}[NHum]     # 'att'

########################### NUMBERS
################## MEASUREMENT
LEXICON Measurement
<msr>:>{Av}டி            # 'ti'     feet

################################     PARTICLES     ################################
LEXICON EmphaticPart
தான்:தான{Pul}                        # 'thaan'

LEXICON CausativePart
வை:வைக்க                            # 'vaykka'
வை:வச்சு                              # 'vaccu'            Dir/LR
செய்:செய்த                            # 'ceitha'          Dir/LR
பண்ணு:பண்ணினா                    # 'panninaa'         Dir/LR
கொள்:கொண்டு                       # 'kontu'            Dir/LR
பிடி:பிடிச்சு                             # 'piticcu'          Dir/LR

LEXICON NegativePart
# Adverbials
இல்லாமல்<neg><adv>:இல்ல>{AA}மல்     # 'illaamal'        without
இல்லாம<neg><adv>:இல்ல>{AA}ம         # 'illaama'         without          Dir/LR
# Negative polarity item
ஒன்றும்<neg>:ஒன்று>ம்                  # 'onrum'           not even one
ஒண்டும்<neg>:ஒண்டு>ம்                # 'ontum'           not even one     Dir/LR
# Negating Auxiliary
இல்லை<neg><vaux>:இல்ல>{AI}          # 'illay'           not exist
இல்ல<neg><vaux>:இல்ல                 # 'illa'            not exist        Dir/LR

LEXICON VocativePart
# UNGENDERED (Intermediate Honorific)
இஞ்சாரப்பா<ihon>:இஞ்சாரப்பா         # 'injcaarappaa'    Hey!
கேட்டுடேய்<ihon>:கேட்டுடேய்           # 'keettuteey'      Hey!
# MALE particles of address (no Honorific)
டேய்<m>:டேய்                           # 'teey'            Hey!
அடா<m>:அடா                          # 'ataa'            Hey!
எடா<m>:எடா                           # 'eta'             Hey!
# FEMALE particles of address (no Honorific)
டியேய்<f>:டியேய்                      # 'tiyeey'          Hey!
அடி<f>:அடி                            # 'ati'             Hey!
எடி<f>:எடி                             # 'eti'             Hey!

LEXICON QuotativePart
எண்டு<quo>:எண்டு                     # 'entu'            that

###############################################################################

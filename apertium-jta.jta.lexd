################################     SUFFIXOLOGY     ################################
########################### GENERAL
################## HONORIFICS
LEXICON Honorifics
# General honorific
<hon>:>{R}{Pul}[H]                                    # 'r'        honorific
# Epicene plural (implied honorific)
<hon>:>{R}{Pul}[EH]                                   # 'r'        honorific
# Plural honorific for other nouns
<hon>:>{K}ள{Pul}[Pl1]                                # 'kal'      plural honorific
<hon>:>{A}வ{AI}[Pl2]                                 # 'avay'     plural honorific
<hon>:>{A}ள{Pul}[Pl3]                                # 'al'       plural honorific
<hon>:>{U}கள{Pul}[Pl4]                              # 'ukal'     plural honorific
<hon>:>{U}ள{Pul}[Pl4]                                # 'ul'       plural honorific      Dir/LR
<hon>:>ம{AA}ர{Pul}[Pl5]                              # 'maar'     plural honorific
<hon>:>{K}ள{Pul}[Pl5]                                # 'kal'      plural honorific      Dir/LR
<hon>:>ம{AA}ர{Pul}[Pl6]                              # 'maar'     plural honorific
<hon>:>{A}வ{AI}[Pl6]                                 # 'avay'     plural honorific      Dir/LR
<hon>:>{A}ள{Pul}[Pl7]                                # 'al'       plural honorific
<hon>:>ம{AA}ர{Pul}[Pl7]                              # 'maar'     plural honorific      Dir/LR
<hon>:>{A}வ{AI}[Pl7]                                 # 'avay'     plural honorific      Dir/LR

# For pronouns (applied to p2,p3)
## p2
<ihon>:>{R}{Pul}[IH]                                  # 'r'   intermediate honorific
<hon>:>{K}ள{Pul}[PH]                                 # 'kal' plural honorific
## p3
<hon>:>{R}{Pul}[MH]                                   # 'r'   male honorific
<hon>:>{AA}[FH]                                       # 'aa'  female honorific
<hon>:>{AI}[EHIrr]                                    # 'ay'  epicene plural honorific
<hon>:>[EHIrrN]                                       #  null irregular epicene plural honorific
<hon><epl>:>வ{AI}[EHIrr2]                            # 'vay' irregular epicene plural honorific

################## NUMBER
LEXICON Number
# ORUMAI: Singular Class: 0
# 0: a. Abstract nouns     [ANoun,QNoun]                         (Always singular)
##   b. Foodstuffs         [FNoun]                               (Always singular)
##   c. Toponyms           [TNoun]                               (Always singular)
##   d. Pronouns           [GPro,PPro,FPro,PS]                   (Singular form)
##   e. Epicenes           [ES,ENS]                              (Dont have regular plural)
##   f. Regular Nouns      [Pl1,Pl2,Pl3,Pl4,Pl5,Pl6,Pl7,Pl8]     (Singular form)
##   g. Honorifics         [IH,H,MH,FH,PH]                       (Forced singular for honorifics 'null')
##   h. Mass Nouns & Time  [UNoun,TiNoun]                        (Uncountable)
<sg>:[ANoun,QNoun,FNoun,TNoun,GPro,PPro,FPro]     # null  singular
<sg>:[ES,ENS,PS,Pl1,Pl2,Pl3,Pl4,Pl5,Pl6,Pl7,Pl8]  # null  singular
<sg>:[IH,H,MH,FH,PH]                              # null  singular
<unc>:[UNoun,TiNoun]                              # null  uncountable

# PANMAI: Plural Classes: 1 through 8
# 1/2: Epicene Plural (Unisex)
# Ungendered forced plural used for groups of people, honorific implied [EH,EHIrr]
<epl>:[EH,EHIrr]                      #  null
# Forced plural for neuter objects
<pl>:>வ{AI}[ENP]                     # 'vay'
###### GENERAL CLASSES
# 1: Common Plural (Inanimate and Animate)
# This plural also applies to pronouns generally [GPro]
<pl>:>{K}{PL}{Pul}[Pl1,GPro,PPro,PL]  # 'kal'
<pl>:>{K}{PL}{Pul}[MH,FH]             # 'kal'
# irregular colloquial pronominal plural
<pl>:>{K}[PPro]                       # 'ka'            Dir/LR

# 2: Plurals of feminine Proper Nouns, people related to locations (Animate)
# This plural also applies to female pronouns [FPro]
<pl>:>{A}வ{AI}[Pl2,FPro]             # 'avay'

# 3: Variation of Common Plural (Inanimate and Animate)
<pl>:>{A}ள{Pul}[Pl3]                 # 'al'

###### AHTHINAI 'irrational beings and inanimate objects' - Low Class (NON-GENDERED)
# 4: Non humans (Inanimate and Irrational Animates)
<pl>:>{U}கள{Pul}[Pl4]               # 'ukal'
## Special form
<pl>:>{U}ள{Pul}[Pl4]                 # 'ul'      Dir/LR

###### UYARTHINAI 'rational beings' - High Class(es) (GENDERED)
# 5: Professional terms and loanwords (Animates)
<pl>:>ம{AA}ர{Pul}[Pl5]               # 'maar'

# 6: Combination of 2 and 5 (Animates) (RELATIONS)
<pl>:>ம{AA}ர{Pul}[Pl6]               # 'maar'
<pl>:>{A}வ{AI}[Pl6]                  # 'avay'    Dir/LR

# 7: Combination of 2, 3 and 5 (Animates only) (Mainly FEMALES)
<pl>:>{A}ள{Pul}[Pl7]                 # 'al'
<pl>:>ம{AA}ர{Pul}[Pl7]               # 'maar'    Dir/LR
<pl>:>{A}வ{AI}[Pl7]                  # 'avay'     Dir/LR

# 8: -N ending nouns (Animates) (MALES)
<pl>:>{R}{Pul}[Pl8]                   # 'r'

################## CASES
LEXICON Cases
# Animates                   [AA]
# Inanimate                  [NN]
# Inanimate irregular        [NNIrr]
# Toponyms                   [TN]
# Pronouns                   [P]
# Pronoun singulars          [PS]
# Pronoun plurals            [PL]

## nominative
<nom>:[AA,NN,NNIrr,TN,P,PS,PL]                                    #  null
## accusative
<acc>:>{AI}[AA,NNIrr,TN,P,PS,PL]                                  # 'ay'
## instrumental
<int>:>{AA}ல{AI}[AA,NN,NNIrr,TN,P,PS,PL]                         # 'aalay~ai'
<int>:>{AA}ல{AIE}[AA,NN,NNIrr,TN,P,PS,PL]                        # 'aalay~ai'           (irregular instrumental)         Dir/LR
<int>:>\ கொண்டு[AA,NN,NNIrr,TN,P,PS,PL]                       # 'kontu'              (irregular instrumental)          Dir/LR
## dative
<dat>:>{U}{K}{Pul}{K}{U}[AA,NN,NNIrr,TN,P,PS,PL]                 # 'ukku'
<dat>:>{A}{K}{Pul}{K}{U}[AA,NN,NNIrr,TN,P,PS,PL]                 # 'akku'               (irregular dative)               Dir/LR
<dat>:>{AI}{K}{Pul}{K}{U}[AA,NN,NNIrr,TN,P,PS,PL]                # 'aykku'              (irregular dative)               Dir/LR
<dat>:>{K}{Pul}{K}{U}[AA,NN,NNIrr,TN,P,PS,PL]                    # 'kku'                (irregular dative)               Dir/LR
<dat>:>{AI}[VIrr]                                                # 'ay'                 (irregular dative for 'veetu')    Dir/LR
## comitative/sociative
<com>:>{OO}ட[AA,NN,NNIrr,TN,P,PS,PL]                             # 'oota'
<com>:>{OO}ட{AI}[AA,NN,NNIrr,TN,P,PS,PL]                         # 'ootay'             (irregular comitative)            Dir/LR
## locative
<loc>:>{I}ல{AI}[AA,NN,NNIrr,TN,P,PS,PL]                          # 'ilay~ai'
<loc>:>{I}ல{AIE}[AA,NN,NNIrr,TN,P,PS,PL]                         # 'ilay~ai'           (irregular locative)              Dir/LR
<loc>:>{I}ல{Pul}[AA,NN,NNIrr,P,PS,PL]                            # 'il'                (irregular locative)              Dir/LR
<loc>:>{I}ல[AA,NN,NNIrr,P,PS,PL]                                 # 'il'                (irregular locative)              Dir/LR
<loc>:>{AI}க்க{AI}[AA,NN,NNIrr,P,PS,PL]                           # 'aykkay'            (colloquial locative)
<loc>:>{U}க்க{AI}[AA,NN,NNIrr,P,PS,PL]                           # 'ukkay'            (colloquial locative var)         Dir/LR
## referential
<refr>:>{Irefr}ட்ட[AA,NNIrr,P,PS,PL]                              # 'itta'
## genitive
<gen>:>{Igen}{N}{Pul}{R}[AA,NN,NNIrr,TN,P,PS]                     # 'inra'
<gen>:>{Igen}{N}{Pul}{R}{AI}[AA,NN,NNIrr,TN,P,PS]                 # 'inra'              (irregular genitive Pronouns)     Dir/LR
<gen>:>{Igen}{N}{Pul}{R}[PL]                                      # 'inra'              (irregular genitive Pronouns)     Dir/LR
<gen>:>{Igen}{N}{Pul}{R}{AI}[PL]                                  # 'inra'              (irregular genitive Pronouns)     Dir/LR
<gen>:>யின்ர[EHIrrN]                                             # 'yinra'             (irregular genitive Pronouns)     Dir/LR
<gen>:>{T}[PL]                                                    # 'ata'               (irregular genitive Pronouns)
<gen>:>{U}ட{AI}ய[P,PS,PL]                                        # 'utayya'           (irregular genitive Pronouns)     Dir/LR
<gen>:>{U}[MGEN]                                                  # 'u'                 (irregular genitive -M Nouns)     Dir/LR
<gen>:[AA,NN,NNIrr,TN,P,PS,PL]                                    #  null               (irregular genitive)              Dir/LR
## ablative
<abl>:>{Irefr}ட்ட\ இருந்து[AA,NNIrr,P,PS,PL]                      # 'itta irunthu'
<abl>:>{I}ல{AI}\ இருந்து[AA,NN,NNIrr,P,TN,PS,PL]                 # 'ilay~ai irunthu'   (irregular ablative)              Dir/LR
<abl>:>{I}ல{AIE}\ இருந்து[AA,NN,NNIrr,TN,P,PS,PL]                # 'ilay~ai irunthu'   (irregular ablative)              Dir/LR
## benefactive
### adds '-aaka' or '-entu' to the dative '-ukku'
<ben>:>{U}க்க>{AA}க[AA,NN,NNIrr,TN,P,PS,PL]                      # 'ukkaaka'
<ben>:>{U}க்க>{E}ண்டு[AA,NN,NNIrr,TN,P,PS,PL]                    # 'ukkentu'                                              Dir/LR
## vocative
<voc>:>{VOW}[AA]                                                  #  vowel lengthener
<voc>:>{EEm}[AA,NN,NNIrr,TN,P,PS,PL]                              # 'ee'                                                   Dir/LR

################## POSTPOSITIONAL SUFFIX
LEXICON PostPosSuf
<post><loc>:>{U}ள்ள[NN,PER2]    # 'ulla'
<post><loc>:>{K}{I}ட்ட[PER]      # 'kitta'
<post><loc>:>{K}{I}ட்ட{U}[PER]   # 'kittu'                        Dir/LR

ALIAS PostPosSuf PostPosSuf2
################## LOCATION
LEXICON Location(2)
# No location prefix for p1,p2
# Mandatory prefix for p3
:{Il}>                    <prx>:
:{Ul}>                    <med>:
:{Al}>                    <dst>:

################## INTERROGATIVE
LEXICON InterroClitic
<qst>:>{AAm}              # 'aa'
<qst>:>{OOm}              # 'oo'      Dir/LR
<qst>:>{EEm}              # 'ee'      Dir/LR

LEXICON InterroPrefix(2)
# instead of the usual clitic '-aa'/'-oo'
# added only for Pronouns, Determiners and Locatives
:{El}>           <qst>:

################## NOMINALIZER
LEXICON Nominalizer
# makes nouns from adjectives
<nmz>:>ம{Pul}[ADJ,VERBInd]                          # 'm'
<nmz>:>ம{AI}[ADJ,VERBInd]                           # 'mai'
# makes nouns from verbs
<nmz>:>{P}{Pul}{P}{U}[VERBInd]                       # 'ppu'
<nmz>:>{P}{U}[VERBInd]                               # 'pu'         Dir/LR
<nmz>:>வ{U}[VERBInd]                                # 'vu'         Dir/LR
<nmz>:>ல{Pul}[ALN]                                  # 'l'
<nmz>:>{A}ல{Pul}[VERBInd]                           # 'al'
<nmz>:>சல{Pul}[VERBInd]                             # 'cal'
## PNG-specific
### human
#### singular
<nmz><m><h><sg>:>வ>ன{Pul}[VERB]                    # 'van'
<nmz><f><h><sg>:>வ>ள{Pul}[VERB]                    # 'val'
<nmz><mf><h><hon><sg>:>வ>ர{Pul}[VERB]               # 'var'
#### plural
<nmz><mf><h><pl>:>வ>{AI}[VERB]                      # 'vay'
<nmz><mf><h><hon><epl>:>வ>ர்>கள{Pul}[VERB]         # 'var'
### non-human
#### singular
<nmz><nt><nh><sg>:>த{U}[VERB]                       # 'athu'

################## INTENSIFIER
LEXICON Intensifier
<emph>:>{U}ம{Pul}                               # 'um'

################## EMPHATIC SUFFIX
LEXICON EmphaticSuf
<emph>:>தான{Pul}                               # 'thaan'
<emph>:>த்தான{Pul}                             # 'ththaan'   Dir/LR

################## ENDWORDMORPH
LEXICON EndwordMorph
# Can appear at the end of certain words matching the next word's first letter through Sandhi
:              
# null so that Dir/LR can work
:>{X}{Pul}                                         # Dir/LR
:>{Y}                                              # Dir/LR

################## ECHO PREFIX
LEXICON EchoPrefix(2)
:ச>           <echo>:

################## TOTALIZING CLITIC
LEXICON TotalClitic
<tot>:>{Um}ம்                             # 'um'        fully

################## CONJUNCTIVE
LEXICON Conjunctive
<cnjcoo>:>{Um}ம்                          # 'um'        and

################## QUOTATIVE
LEXICON QuotativeSuf
<quo>:>{E}ண்ட{U}                        # 'entu'      (quoting) that
<quo>:>{AA}ம{Pul}                        # 'aam'       (hearsay) that

########################### NOUNS
################## EMPHATIC
LEXICON EmphaticCli
<emph>:>{AI}                                     # 'ay'
<emph>:>{EE}                                     # 'ee'        Dir/LR
<emph>:>{EE}{Y}{EE}                              # 'eeyee'     Dir/LR

################## PREDICATIVE
LEXICON Predicative
# Pronominalizing predicatives (GENDERED)
<prnz><pred><nt>:>{C}{U}[NPREDS]                 # 'cu'        neuter (adjectives) 
<prnz><pred><nt>:>த{U}[NPREDS]                  # 'thu'       neuter (adjectives)   variant  
<prnz><pred><nt>:[NPREDP]                        # null        neuter (adjectives)    built-in through plural number 
<prnz><pred>:[PREDP]                             # null        epicene (adjectives)   built-in through plural number 
<prnz><pred><f>:>வ{PLR}{Pul}[APRED]             # 'val'       female (adjectives)  
<prnz><pred><m>:>வ{NR}{Pul}[APRED]              # 'van'       male (adjectives)  

################## ADVERBIALIZER
LEXICON Adverbializer
<advz>:>{AAm}ய்                                  # 'aai'
<advz>:>{AAm}க                                  # 'aaka'
<advz>:>{AAp}                                    # 'aa'          Dir/LR

################## ADJECTIVIZER
LEXICON Adjectivizer
# Quality
<adjz><qual>:>{AAm}ன                        # 'aana'
# Quantity
<adjz><quan>:>{AAm}ன                        # 'aana'               used often for both
<adjz><quan>:>{Um}ள்ள                       # 'ulla'                Dir/LR
# Negating adjectivizer
<neg><vaux><adjz>:>{Im}ல்ல>{AA}த            # 'illatha'

################## PROFESSIONALIZER
LEXICON Professionalizer
# 'kaaran' is usually added for professions (female eq. 'kaari')
# this is changed to 'kaarar' in both male and female to denote honor
## general
<m>:>{Kk}{AA}ர{N}{Pul}
<f>:>{Kk}{AA}ர{I}
<hon>:>{Kk}{AA}ர{R}{Pul}
## others
<m>:>{AA}ள{Pul}

################## COMPARATIVE SUFFIX
LEXICON ComparativeSuf
# Comparison
<comp>:விட                     # 'vita'        than
<comp>:காட்டிலும{Pul}          # 'kaattilum'   than
<comp>:பார்க்க                  # 'paarkka'     than
<comp>:பாக்க                   # 'paakka'      than        Dir/LR
<comp>:பார்க்கிலும{Pul}        # 'paarkkilum'  than
# Equatives
<eq>:போலே                   # 'poolee'      like
<eq>:மாதிரி                    # 'maathiri'    like

########################### VERBS
################## VOICE
LEXICON Voice
<actv>:[ACT]
<pasv>:>{P}{Pul}{P}{T}{U}[PASSIVE1]        # 'ppatu'
<pasv>:>{U}ண்{T}{U}[PASSIVE2]             # 'untu'      eat       meaning is non-existent and thus verb as <vaux> is lost

################## CAUSATIVE
LEXICON Causativiser
# Weak verb causative marker
<caus>:>வி[W]                                                           # 'vi'

# Irregular verb causative marker
<caus>:>வி[Class5a,Class5b,Class5d,Class5e,Class5f]                     # 'vi'
<caus>:>பி[Class5c]                                                     # 'pi'

# Strong verb causative marker
<caus>:>ப்பி[S]                                                          # 'ppi'
<caus>:>பி[S]                                                           # 'pi'

# Irregular causative markers
<caus>:>த்த{U}[W,S,Class5a,Class5b,Class5c,Class5d,Class5e,Class5f]     # 'ththu'
<caus>:>{II}[CAUSIRR]                                                   # 'ii'

# Irregular double causative marker
<caus><caus>:விப்பி[WEAKDOUBCAUS]                                       # 'vippi'
<caus><caus>:த்துவி[STRONGDOUBCAUS]                                     # 'ththuvi'

################## AUXILIARY SUFFIX
LEXICON ModAuxSuffix
# modals
<vaux><vbmod><pot>:>லாம்              # 'laam'          may
<vaux><vbmod><coh>:>{A}ட்டும{Pul}      # 'attum'         let
<vaux><vbmod><coh>:>{Av}ட்டும{Pul}     # 'attum'         let
<vaux><vbmod>:>{OOv}ண>{U}ம{Pul}     # 'oonum'         must
<vaux><vbmod>:>வேண>{U}ம{Pul}       # 'venum'         should
<vaux><vbmod>:>வேண்ட{I}             # 'venti'         should
<vaux><vbmod>:>{EEv}லும{Pul}          # 'eelum'         possible
## negatives
<neg><vaux><vbmod>:>வேண்ட>{AA}>ம்   # 'ventaam'       should not
<neg><vaux><vbmod>:>{EEv}லாத{U}      # 'eelaathu'      not possible
<neg><vaux><vbmod>:>கூட>{AA}>த{U}    # 'kuutaathu'     must not
<neg><vaux><vbmod>:>கூட>{AA}         # 'kuutaa'         must not
<neg><vaux><vbmod>:>பட>{AA}>த{U}    # 'pataathu'       not happening
<neg><vaux><vbmod>:>ப்பட>{AA}>த{U}   # 'ppataathu'     not happening

LEXICON AspAuxSuffix
# aspectuals
## perfectives
### after participles
<vaux><perf>:>{I}ட்ட{U}[Nor]                            # 'ittu'      (completion)
<vaux><perf>:>ட்ட{U}[Nor]                               # 'ttu'       (completion)     Dir/LR
#### taking tense and PNG
<vaux><vbser><perf>:>{I}ர{U}[IRU]                      # 'iru'        (completion)
<vaux><perf>:>ப்ப{OO}[IRU2]                             # 'poo'       (near)           Dir/LR
### after tenses
<vaux><perf>:>{U}போட்ட{U}[STAT]                       # 'poottu'    (completion) 

## progressives
<vaux><prog>:>க்கொண்>டிரு[IRU]                       # 'kkontiru'   (completion)
<vaux><prog>:>க்\ கொண்>டிரு[IRU]                     # 'k kontiru'  (completion)    Dir/LR

################## NEGATION SUFFIX
LEXICON NegSuffix
# Some require preceding infinitives [INF]
# Some are dynamic and require infinitives [DYN]
## Auxiliaries
<neg><vaux>:>{I}ல்லை[INF]                  # 'illay'
<neg><vaux>:>{EEv}ல்லை[INF]                # 'eellay'         Dir/LR
<neg><vaux>:>{EEv}லை[INF]                  # 'eelay'          Dir/LR
<neg><vaux>:>{EEv}ல்ல[INF]                  # 'eell'           Dir/LR
<neg><vaux>:>{EEv}ல[INF]                    # 'eel'            Dir/LR
<neg><vaux>:>ல{E}[INF]                      # 'le'             Dir/LR
<neg><vaux>:>ல{EE}[INF]                     # 'lee'            Dir/LR
<neg><vaux><fut>:>மா{T}{Pul}[DYN]          # 'maat'
<neg><vaux><fut>:>மா{T}{Pul}{T}[DYN]       # 'maatt'          Dir/LR
## Adverbs
<neg><adv><par>:>{AA}>மல்                   # 'aamal'
<neg><adv><par>:>{AA}>ம                     # 'aama'           Dir/LR
## Adjectives
<neg><adj><par>:>{AA}>த                     # 'aatha'

################## NEGATION
LEXICON Negation
<neg>:>{AAv}[Nor]                                  # 'aa'
<neg>:>{AAv}த[NOM]                                # 'aatha'

################## ASPECT
LEXICON Aspect
# attaches to Defective verbs to form habitual aspect
<aor><hab>:>{U}ம்                                 # 'um'


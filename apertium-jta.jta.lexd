<temp>:>{AIv}க்க{AI}                             # 'aykkay'     while
<temp>:>{EEv}க்க{AI}                             # 'eekkay'     while         Dir/LR
<temp>:>{P}{OO}த{U}[PART]                        # 'poothu'     while

################## INFINITIVE
LEXICON Infinitives
# weak
<inf>:>{A}[W]                                    # 'a'
# irregulars
<inf>:>{K}{A}[Class5a]                           # 'ka'
<inf>:>{A}[Class5b]                              # 'a'
<inf>:>ண{A}[Class5c]                           # 'na'
<inf>:>{K}{A}[Class5d]                           # 'ka'
<inf>:>{K}{A}[Class5e]                           # 'ka'
<inf>:>ன{A}                                     # 'na'
<inf>:>{A}                                       # 'a'          Dir/LR
<inf>:>ர{A}[I1]                                  # 'ra'
<inf>:>{K}{A}[I2]                                # 'ka'
<inf>:>ய{A}[ClassDef]                           # 'ya'
# strong
<inf>:>{K}{Pul}{K}{A}[S]                         # 'kka'

################## PARTICIPLE
LEXICON PassParticiple
<par><adv>:>{Uu}                                 # 'u'
<par><adj>:>{A}                                  # 'a'

LEXICON Participle
# Class wise word-ending
## Adverbials
## Adverbials are non-time
<par><adv>:>த{U}[Class1a]                                                                  # 'thu'
<par><adv>:>{T}{U}[Class1b]                                                                 # 'tu'
<par><adv>:>{RR}{U}[Class1c]                                                                # 'ru' 
<par><adv>:>ந{Pul}த{U}[Class2]                                                             # 'nthu'
<par><adv>:>ஞ{Pul}ச{U}[Class2]                                                            # 'njcu'           Dir/LR
<par><adv>:>{I}[Class3]                                                                     # 'i'
<par><adv>:>ய{Pul}[Class3Irr]                                                              # 'y'
<par><adv>:>{TR}{U}[Class4]                                                                 # 'ru'/'tu'
<par><adv>:>{RR}{U}[Class5a]                                                                # 'ru'
<par><adv>:>ன{U}[Class5a]                                                                  # 'nu'            Dir/LR
<par><adv>:>{I}[Class5b]                                                                    # 'i'
<par><adv>:>{T}{U}[Class5c]                                                                 # 'tu'
<par><adv>:>{T}{U}[Class5d]                                                                 # 'tu'
<par><adv>:>{RR}{U}[Class5e]                                                                # 'ru'
<par><adv>:>{RR}{U}[Class5f]                                                                # 'ru'
<par><adv>:>{T}{U}[Class5f]                                                                 # 'tu'             Dir/LR
<par><adv>:>த{Pul}த{U}[Class6]                                                             # 'ththu'
<par><adv>:>ச{Pul}ச{U}[Class6]                                                             # 'ccu'            Dir/LR
<par><adv>:>ச{Pul}ச{I}[Class6]                                                             # 'cci'            Dir/LR 
<par><adv>:>ந{Pul}த{U}[Class7]                                                             # 'nthu'
<par><adv>:>ஞ{Pul}ச{U}[Class7]                                                            # 'njcu'           Dir/LR

## Adjectivals
## Adjectivals indicate time
### past
<par><adj><past>:>த[Class1a]                                                                 # 'th'
<par><adj><past>:>{T}[Class1b]                                                                # 't'
<par><adj><past>:>{RR}[Class1c]                                                               # 'r'
<par><adj><past>:>ந{Pul}த[Class2]                                                            # 'nth'
<par><adj><past>:>ஞ{Pul}ச[Class2]                                                            # 'njc'         Dir/LR
<par><adj><past>:>{I}ய[Class3]                                                               # 'iya'
<par><adj><past>:>ன[Class3Irr]                                                               # 'n'
<par><adj><past>:>ச{Pul}ச[Class3Irr]                                                         # 'cc'           Dir/LR
<par><adj><past>:>{TR}[Class4]                                                                # 'r'/'t'
<par><adj><past>:>{RR}[Class5a]                                                               # 'r'
<par><adj><past>:>{Nn}[Class5b]                                                               # 'n'
<par><adj><past>:>{T}[Class5c]                                                                # 't'
<par><adj><past>:>{T}[Class5d]                                                                # 't'
<par><adj><past>:>{RR}[Class5e]                                                               # 'r'
<par><adj><past>:>{RR}[Class5f]                                                               # 'r'
<par><adj><past>:>{T}[Class5f]                                                                # 't'            Dir/LR
<par><adj><past>:>த{Pul}த[Class6]                                                            # 'thth'
<par><adj><past>:>ச{Pul}ச[Class6]                                                            # 'cc'           Dir/LR
<par><adj><past>:>ந{Pul}த[Class7]                                                            # 'nth'
<par><adj><past>:>ஞ{Pul}ச[Class7]                                                           # 'njc'          Dir/LR
### present
#### weak form
<par><adj><pres>:>{K}{I}ற[Class1a,Class1b,Class1c,Class2,Class3,Class3Irr,Class4]            # 'kir'
<par><adj><pres>:>{K}{I}ன்ற[Class1a,Class1b,Class1c,Class2,Class3,Class3Irr,Class4]          # 'kinr'         Dir/LR
<par><adj><pres>:>ற[Class1a,Class1b,Class1c,Class2,Class3,Class3Irr,Class4]                  # 'r'            Dir/LR
#### irregular class
<par><adj><pres>:>{K}{I}ற[Class5a,Class5b,Class5c,Class5d,Class5e,Class5f]                   # 'kir'
<par><adj><pres>:>{K}{I}ன்ற[Class5a,Class5b,Class5c,Class5d,Class5e,Class5f]                 # 'kinr'         Dir/LR
<par><adj><pres>:>ற[Class5a,Class5b,Class5c,Class5d,Class5e,Class5f]                         # 'r'            Dir/LR
#### strong form
<par><adj><pres>:>{K}{Pul}{K}{I}ற[Class6,Class7]                                             # 'kkir'
<par><adj><pres>:>{K}{Pul}{K}{I}ன்ற[Class6,Class7]                                           # 'kkinr'        Dir/LR
<par><adj><pres>:>ற[Class6,Class7]                                                           # 'r'            Dir/LR
### future
#### weak form
<par><adj><fut>:>{U}ம்[Class1a,Class1b,Class1c,Class2,Class3,Class4]                          # 'um'
#### irregular class/form
<par><adj><fut>:>{K}{U}ம்[Class3Irr,Class5a,Class5d,Class5e]                                  # 'kum'
<par><adj><fut>:>{U}ம்[Class5b,Class5c,Class5f]                                               # 'um'
<par><adj><fut>:>ன{U}ம்[Class5f]                                                             # 'num'          Dir/LR
#### strong form
<par><adj><fut>:>{K}{Pul}{K}{U}ம{Pul}[Class6,Class7]                                         # 'kkum'

################## IMPERATIVES
LEXICON Imperatives
# positives
<imp><sg>:[POS,POSIrr]                             #  null              singular
<imp><sg>:>{U}[POS]                                # 'u'                irregular singular                Dir/LR
<imp><hon><sg>:>{U}ம{Pul}[POS]                    # 'um'               singular honorific
<imp><hon><sg>:>{UIrr}ம{Pul}[POSIrr]              # 'um'               irregular singular honorific      Dir/LR
<imp><pl>:>{Uimp}ங்கோ[POS,POSIrr]               # 'unkoo'            plural
<imp><pl>:>{U}ங{Pul}கள்[POS,POSIrr]              # 'unkal'            irregular plural                  Dir/LR
# negative imperative
<neg><imp><sg>:>{AAv}த{EE}[NEG]                   # 'aathee'           singular
<neg><imp><sg>:>{AA}த[NEG]                        # 'aatha'            singular                          Dir/LR
<neg><imp><hon><sg>:>{AA}த>யும{Pul}[NEG]         # 'aathayum'         singular honorific
<neg><imp><pl>:>{AA}த>யுங்கோ[NEG]               # 'aathayunkoo'      plural

################## PERSON, NUMBER, GENDER
LEXICON PNG
# p1
<p1><sg>:>{EE}>ன{Pul}[Nor]                      # 'een'       singular
<p1><sg>:>{E}>ன{Pul}[Nor]                       # 'en'        singular       (var)                      Dir/LR
<p1><sg>:>ன{Pul}[Nor]                           # 'n'         singular       (var)                      Dir/LR
<p1><sg>:>னான{Pul}[Nor]                       # 'naan'       singular       (var)                      Dir/LR
<p1><pl>:>ம{Pul}[Nor]                            # 'm'         plural
<p1><pl>:>{OO}ம{Pul}[Nor]                        # 'om'        plural         (var)                      Dir/LR
<p1><pl>:>ன{AA}ங்கள{Pul}[Nor]                 # 'naankal'    plural         (var)                      Dir/LR
# p2
<p2><sg>:>{AAv}ய{Pul}[Nor]                      # 'aay'       singular
<p2><sg>:>{I}[Nor]                               # 'i'         singular       (var)                      Dir/LR
<p2><ihon><sg>:>{II}>ர{Pul}[Nor]                 # 'iir'       singular       (intermediate honorific)
<p2><hon><sg>:>{II}>ங்>கள{Pul}[Nor]             # 'iinkal'    singular       (honorific)
<p2><pl>:>{I}ய>ள{Pul}[Nor]                      # 'iyal'      plural
<p2><pl>:>{II}>ங்>கள{Pul}[Nor]                  # 'iinkal'    plural         (var)                      Dir/LR
<p2><pl>:>{II}>ர்>கள{Pul}[Nor]                   # 'iirkal'    plural         (var)                      Dir/LR
# p3
## human
<p3><h><m><sg>:>{AAv}>ன{Pul}[Nor]               # 'aan'       singular       (masc)
<p3><h><m><hon><sg>:>{AAv}>ர{Pul}[Nor]           # 'aar'       singular       (masc honorific)
<p3><h><m><pl>:>{AAv}>ங்>கள{Pul}[Nor]           # 'aankal'    plural         (masc)
<p3><h><m><pl>:>{AAv}>ர்>கள{Pul}[Nor]           # 'aarkal'     plural         (masc var)                 Dir/LR
<p3><h><m><pl>:>ர{Pul}[Nor]                      # 'r'         plural         (masc var)                 Dir/LR
<p3><h><f><sg>:>{AAv}>ள{Pul}[Nor]               # 'aal'       singular       (fem)
<p3><h><f><hon><sg>:>{AAv}[Nor]                  # 'aa'        singular       (fem honorific)
<p3><h><f><pl>:>{AAv}ளவ{AI}[Nor]               # 'aalavay'   plural         (fem)
<p3><h><f><pl>:>{AAv}>ளு>கள{Pul}[Nor]          # 'aalukal'   plural         (fem var)                  Dir/LR  
<p3><h><epl><hon>:>{I}னம{Pul}[Nor,P3EP]        # 'inam'      epicene plural (honorific)
## non-human
<p3><nh><sg>:>த{U}[Nor,NHumE2]                  # 'tu'        singular       (non-human)
<p3><nh><sg>:>{U}                               # 'u'         singular       (non-human var)            Dir/LR  (only for [Irr])
<p3><nh><sg>:>{UA}த{U}[Nor,NHum]                # 'utu'       singular       (non-human var)            Dir/LR
<p3><nh><pl>:>ன[Nor,NHum]                      # 'na'        plural         (non-human)
<p3><nh><pl>:>த{U}>கள{Pul}[Nor,NHumE2]        # 'tukal'     plural         (non-human var)            Dir/LR
<p3><nh><pl>:>{UA}த{U}>கள{Pul}[Nor,NHum]      # 'utukal'    plural         (non-human var)            Dir/LR
### empty forms added for future tense
<p3><nh><sg>:[NHumE]                            # null       singular       (non-human)
<p3><nh><pl>:[NHumE,NHumE2]                     # null       plural         (non-human)

LEXICON PartPNG
# p1
<p1><sg>:>வ{EE}>ன{Pul}                      # 'een'        singular
<p1><sg>:>வ{E}>ன{Pul}                       # 'en'         singular       (var)                      Dir/LR
<p1><pl>:>வ{OO}ம{Pul}                       # 'om'         plural
<p1><pl>:>ன{AA}ங்கள{Pul}[Nor]              # 'naankal'    plural         (var)                      Dir/LR

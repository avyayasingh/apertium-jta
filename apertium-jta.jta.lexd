################################     SUFFIXOLOGY     ################################
########################### GENERAL
################## HONORIFICS
LEXICON Honorifics
## 'kaaran' is usually added for professions (female eq. 'kaari')
## this is changed to 'kaarar' in both male and female to denote honor
## this is similar to the general honorific, '-r', which changes (mainly male) '-n' ending nouns
# General honorific
<hon>:>{R}{Pul}[H]                                    # 'r'        honorific
# Epicene plural (implied honorific)
<hon>:>{R}{Pul}[EH]                                   # 'r'        honorific
# Plural honorific for other nouns
<hon>:>{K}ள{Pul}[Pl1]                                # 'kal'      plural honorific
<hon>:>{A}வ{AI}[Pl2]                                 # 'avay'     plural honorific
<hon>:>{A}ள{Pul}[Pl3]                                # 'al'       plural honorific
<hon>:>{U}கள{Pul}[Pl4]                              # 'ukal'     plural honorific
<hon>:>{U}ள{Pul}[Pl4]                                # 'ul'       plural honorific      Dir/LR
<hon>:>ம{AA}ர{Pul}[Pl5]                              # 'maar'     plural honorific
<hon>:>{K}ள{Pul}[Pl5]                                # 'kal'      plural honorific      Dir/LR
<hon>:>ம{AA}ர{Pul}[Pl6]                              # 'maar'     plural honorific
<hon>:>{A}வ{AI}[Pl6]                                 # 'avay'     plural honorific      Dir/LR
<hon>:>{A}ள{Pul}[Pl7]                                # 'al'       plural honorific
<hon>:>ம{AA}ர{Pul}[Pl7]                              # 'maar'     plural honorific      Dir/LR
<hon>:>{A}வ{AI}[Pl7]                                 # 'avay'     plural honorific      Dir/LR

# For pronouns (applied to p2,p3)
## p2
<ihon>:>{R}{Pul}[IH]                                  # 'r'   intermediate honorific
<hon>:>{K}ள{Pul}[PH]                                 # 'kal' plural honorific
## p3
<hon>:>{R}{Pul}[MH]                                   # 'r'   male honorific
<hon>:>{AA}[FH]                                       # 'aa'  female honorific
<hon>:>{AI}[EHIrr]                                    # 'ay'  epicene plural honorific
<hon>:>[EHIrrN]                                       #  null irregular epicene plural honorific
<hon><epl>:>வ{AI}[EHIrr2]                            # 'vay' irregular epicene plural honorific

################## NUMBER
LEXICON Number
# ORUMAI: Singular Class: 0
# 0: a. Abstract nouns     [ANoun]                               (Always singular)
##   b. Foodstuffs         [FNoun]                               (Always singular)
##   c. Toponyms           [TNoun]                               (Always singular)
##   d. Pronouns           [GPro,FPro]                           (Singular form)
##   e. Epicenes           [ES]                                  (Dont have regular plural)
##   f. Regular Nouns      [Pl1,Pl2,Pl3,Pl4,Pl5,Pl6,Pl7,Pl8]     (Singular form)
##   g. Honorifics         [IH,H,MH,FH,PH]                       (Forced singular for honorifics 'null')
##   h. Mass Nouns & Time  [UNoun]                               (Uncountable)
<sg>:[ANoun,FNoun,TNoun,GPro,FPro]                # null  singular
<sg>:[ES,ENS,PS,Pl1,Pl2,Pl3,Pl4,Pl5,Pl6,Pl7,Pl8]  # null  singular
<sg>:[IH,H,FH,MH,PH]                              # null  singular
<unc>:[UNoun]                                     # null  uncountable

# PANMAI: Plural Classes: 1 through 8
# 1/2: Epicene Plural (Unisex)
# Ungendered forced plural used for groups of people, honorific implied [EH,EHIrr]
<epl>:[EH,EHIrr]
# Forced plural for neuter objects, 'vay' suffix
<pl>:>வ{AI}[ENP] 
###### GENERAL CLASSES
# 1: Common Plural (Inanimate and Animate)
# This plural also applies to pronouns generally [GPro]
<pl>:>{K}{PL}{Pul}[Pl1,GPro,PL]      # 'kal'

# 2: Plurals of feminine Proper Nouns, people related to locations (Animate)
# This plural also applies to female pronouns [FPro]
<pl>:>{A}வ{AI}[Pl2,FPro]            # 'avay'

# 3: Variation of Common Plural (Inanimate and Animate)
<pl>:>{A}ள{Pul}[Pl3]                # 'al'

###### AHTHINAI 'irrational beings and inanimate objects' - Low Class (NON-GENDERED)
# 4: Non humans (Inanimate and Irrational Animates)
<pl>:>{U}கள{Pul}[Pl4]              # 'ukal'
## Special form
<pl>:>{U}ள{Pul}[Pl4]                # 'ul'      Dir/LR

###### UYARTHINAI 'rational beings' - High Class(es) (GENDERED)
# 5: Professional terms and loanwords (Animates)
<pl>:>ம{AA}ர{Pul}[Pl5]              # 'maar'

# 6: Combination of 2 and 5 (Animates) (RELATIONS)
<pl>:>ம{AA}ர{Pul}[Pl6]              # 'maar'
<pl>:>{A}வ{AI}[Pl6]                 # 'avay'    Dir/LR

# 7: Combination of 2, 3 and 5 (Animates only) (Mainly FEMALES)
<pl>:>{A}ள{Pul}[Pl7]                # 'al'
<pl>:>ம{AA}ர{Pul}[Pl7]              # 'maar'    Dir/LR
<pl>:>{A}வ{AI}[Pl7]                 # 'avay'     Dir/LR

# 8: -N ending nouns (Animates) (MALES)
<pl>:>{R}{Pul}[Pl8]                  # 'r'

################## CASES
LEXICON Cases
<nom>:[AA,NN,TN,P,PS,PL]                                    #  null
<acc>:>{AI}[AA,TN,P,PS,PL]                                  # 'ay'
<int>:>{AA}ல{AIE}[AA,NN,TN,P,PS,PL]                        # 'aalay~ai'
<int>:>\ கொண்டு[AA,NN,TN,P,PS,PL]                       # 'kontu'              (irregular instrumental)          Dir/LR
<dat>:>{U}க்கு[AA,NN,TN,P,PS,PL]                            # 'ukku'
<dat>:>{AI}[VIrr]                                          # 'ay'                 (irregular dative for 'veetu')    Dir/LR
<com>:>{OO}ட[AA,NN,TN,P,PS,PL]                             # 'oota'
<loc>:>{I}ல{AIE}[AA,NN,TN,P,PS,PL]                         # 'ilay~ai'
<loc>:>{I}ல[AA,NN]                                         # 'il'                (irregular locative)              Dir/LR
<loc>:>\ இருந்து[AA,NN,TN,P,PS,PL]                          # 'irunthu'           (irregular locative)              Dir/LR
<refr>:>{Irefr}ட்ட[AA,P,PS,PL]                              # 'itta'
<gen>:>{I}{N}{Pul}{R}[AA,NN,TN,P,PS]                        # 'inra'
<gen>:>{I}{N}{Pul}{R}[PL]                                   # 'inra'              (irregular genitive Pronouns)     Dir/LR
<gen>:>யின்ர[EHIrrN]                                       # 'yinra'             (irregular genitive Pronouns)     Dir/LR
<gen>:>{T}[PL]                                              # 'ata'               (irregular genitive Pronouns)
<gen>:>{U}ட{AI}ய[P,PS,PL]                                  # 'utayya'           (irregular genitive Pronouns)     Dir/LR
<gen>:[AA,NN,TN]                                            #  null               (irregular genitive)              Dir/LR
<abl>:>{I}ட்ட\ இருந்து[AA,P,PS,PL]                          # 'itta irunthu'
<abl>:>{I}ல{AIE}\ இருந்து[AA,NN,P,TN,PS,PL]                # 'ilay~ai irunthu'   (irregular ablative)              Dir/LR
# Benefactive is irregular 
# adds '-aaka' or '-entu' to the dative '-ukku'
<ben>:>{U}க்க>{AA}க[AA,NN,TN,P,PS,PL]                      # 'ukkaaka'
<ben>:>{U}க்க>{E}ண்டு[AA,NN,TN,P,PS,PL]                    # 'ukkentu'                                              Dir/LR

################## LOCATION
LEXICON Location(2)
# No location prefix for p1,p2
# Mandatory prefix for p3
:இ>                     <prx>:
:உ>                     <med>:
:அ>                     <dst>:

################## INTERROGATIVE
LEXICON InterroClitic
<qst>:>{AA}              # 'aa'
<qst>:>{OO}              # 'oo'      Dir/LR

LEXICON InterroPrefix(2)
# instead of the usual clitic '-aa'/'-oo'
# added only for Pronouns, Determiners and Locatives
:எ>           <qst>:

########################### ADJECTIVES
LEXICON Nominalizer
# makes nouns from adjectives
<nmz>:>ம{AI}[ADJ]                    # 'mai'
# makes nouns from verbs
<nmz>:>{AA}த{U}[VERB]                # 'aathu'

########################### NOUNS
################## EMPHATIC
LEXICON EmphaticSuf
<emph>:>{AI}                                     # 'ay'

################## PREDICATIVE
LEXICON Predicative
# Pronominalizing predicatives (GENDERED)
<prnz><pred><nt>:>{C}{U}[NPREDS]                 # 'cu'        neuter (adjectives)  
<prnz><pred><nt>:[NPREDP]                        # null        neuter (adjectives)    built-in through plural number 
<prnz><pred>:[PREDP]                             # null        epicene (adjectives)   built-in through plural number 
<prnz><pred><f>:>வ{PLR}{Pul}[APRED]             # 'val'       female (adjectives)  
<prnz><pred><m>:>வ{NR}{Pul}[APRED]              # 'van'       male (adjectives)  

################## ADVERBIALIZER
LEXICON Adverbializer
<advz>:>{AAm}ய்                                  # 'aai'
<advz>:>{AAm}க                                  # 'aaka'        Dir/LR

################## ENDWORDMORPH
LEXICON EndwordMorph
# Can appear at the end of certain words matching the next word's first letter through Sandhi
:              
# null so that Dir/LR can work
:>{X}{Pul}                                         # Dir/LR

################## ADJECTIVIZER
LEXICON Adjectivizer
# Quality
<adjz><qual>:>{AAm}ன                        # 'aana'
# Quantity
<adjz><quan>:>{AAm}ன                        # 'aana'               used often for both
<adjz><quan>:>{Um}ள்ள                       # 'ulla'                Dir/LR
# Negating adjectivizer
<neg><vaux><adjz>:>{Im}ல்ல>{AA}த            # 'illatha'

################## TOTALIZING CLITIC
LEXICON TotalClitic
<tot>:>{Um}ம்                                # 'um'                 fully

########################### VERBS
################## VOICE
LEXICON Voice
<actv>:
<pasv>:>ப்பட்ட{U}                        # 'ppattu'
<pasv>:>{U}ண்ட{U}[PASSIVE]              # 'untu'      eat       meaning is non-existent and thus verb as <vaux> is lost

################## CAUSATIVE
LEXICON Causativiser
# Weak verb causitive marker
<caus>:>வி[Class1a,Class1b,Class1c,Class2,Class3,Class4,Class5,INTRACAUS]      # 'vi'

# Strong verb causitive marker
<caus>:>ப்பி[Class6,Class7]                                                     # 'ppi'

# Irregular causitive markers
<caus>:>த்து[CAUSIRR1]                            # 'ththu'
<caus>:>{II}[CAUSIRR2]                            # 'ii'

# Irregular double causitive marker
<caus><caus>:விப்பி[WEAKDOUBCAUS]                 # 'vippi'
<caus><caus>:த்துவி[STRONGDOUBCAUS]               # 'ththuvi'

################## AUXILIARY SUFFIX
LEXICON AuxSuffix
<vaux><vbmod>:>லாம்                   # 'laam'      may
<vaux><vbmod>:>{A}ட்டும்                # 'attum'     let

################## NEGATION SUFFIX
LEXICON NegSuffix
# Some require preceding infinitives [INF]
# Some are dynamic and require infinitives [DYN]
## <vaux>
<neg><vaux>:>{I}ல்லை[INF]                  # 'illay'
<neg><vaux>:>லெ[INF]                       # 'illay'          Dir/LR
மாட்<vaux><fut>:மா{T}{Pul}[DYN]            # 'maat'
## <adv>
<neg><adv><par>:>{AA}>மல்                   # 'aamal'
<neg><adv><par>:>{AA}>ம                     # 'aama'           Dir/LR
## <adj>
<neg><adj><par>:>{AA}>த                     # 'aatha'
# fix negsuffix by adding more from book
################## NEGATION
LEXICON Negation
<neg>:>{AA}                                       # 'aa'

################## ASPECT
LEXICON Aspect
# attaches to Defective verbs to form habitual aspect
<aor><hab>:>{U}ம்                                 # 'um'

################## INFINITIVE
LEXICON Infinitives
<inf>:>{A}                                        # 'a'           
# fix based on letter ending

################## PARTICIPLE
LEXICON Participle
# Class wise word-ending
## Adverbials
## Adverbials are non-time
<par><adv>:>து[Class1a]                                                           # 'thu'
<par><adv>:>{T}{U}[Class1b]                                                       # 'tu'
<par><adv>:>{RR}{U}[Class1c]                                                      # 'ru' 
<par><adv>:>ந்து[Class2]                                                           # 'nthu'
<par><adv>:>{I}[Class3]                                                           # 'i'
<par><adv>:>ய்[Class3Irr]                                                         # 'y'
<par><adv>:>{TR}{U}[Class4]                                                       # 'ru'/'tu'
<par><adv>:>{RR}{U}[Class5a]                                                      # 'ru'
<par><adv>:>{I}[Class5b]                                                          # 'i'
<par><adv>:>{T}{U}[Class5c]                                                       # 'tu'
<par><adv>:>த்து[Class6]                                                          # 'ththu'
<par><adv>:>ந்து[Class7]                                                          # 'nthu'

## Adjectivals
## Adjectivals indicate time
### past
<par><adj><past>:>த[Class1a]                                                       # 'th'
<par><adj><past>:>{T}[Class1b]                                                      # 't'
<par><adj><past>:>{RR}[Class1c]                                                     # 'r'
<par><adj><past>:>ந்த[Class2]                                                       # 'nth'
<par><adj><past>:>{I}ய[Class3]                                                     # 'iya'
<par><adj><past>:>ன[Class3Irr]                                                     # 'n'
<par><adj><past>:>{TR}[Class4]                                                      # 'r'/'t'
<par><adj><past>:>{RR}[Class5a]                                                     # 'r'
<par><adj><past>:>{Nn}[Class5b]                                                     # 'n'
<par><adj><past>:>{T}[Class5c]                                                      # 't'
<par><adj><past>:>த்த[Class6]                                                       # 'thth'
<par><adj><past>:>ந்த[Class7]                                                       # 'nth'
### present
#### weak form
<par><adj><pres>:>{K}{I}ற[Class1a,Class1b,Class1c,Class2,Class3,Class3Irr,Class4]  # 'kir'
#### irregular class
<par><adj><pres>:>கிற[Class5a,Class5b,Class5c]                                     # 'kir'
#### strong form
<par><adj><pres>:>க்கிற[Class6,Class7]                                             # 'kkir'
### future
#### weak form
<par><adj><fut>:>{U}ம்[Class1a,Class1b,Class1c,Class2,Class3,Class4]                # 'um'
#### irregular class/form
<par><adj><fut>:>{K}{U}ம்[Class3Irr,Class5a]                                        # 'kum'
<par><adj><fut>:>{U}ம்[Class5b,Class5c]                                             # 'um'
#### strong form
<par><adj><fut>:>க்கும்[Class6,Class7]                                              # 'kkum'

################## IMPERATIVES
LEXICON Imperatives
# positives
<imp><sg>:                                    #  null              singular
<imp><hon><sg>:>{U}ம்                         # 'um'               singular honorific
<imp><pl>:>{U}ங்கோ                         # 'unkoo'             plural
# negative imperative
<neg><imp><sg>:>{AA}த{EE}                    # 'aathee'           singular
<neg><imp><sg>:>{AA}த                        # 'aatha'            singular                     Dir/LR
<neg><imp><hon><sg>:>{AA}த>யும்              # 'aathayum'         singular honorific
<neg><imp><pl>:>{AA}த>யுங்கோ               # 'aathayunkoo'      plural


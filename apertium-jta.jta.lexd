# fix ask about n changing before kal plural
# fix ask about n changes to r to give honorific in plural for male humans. swap honorific and number if needed
################################     VERBS     ################################
# Verb Classes:
# 1-4:  Melvinaigal (Weak)
# 5:    Irregulars
# 6-7:  Valvinaigal (Strong)
##########
# General verbs and Aspectual Auxiliaries belong to 7 classes as discussed above
# Modal Auxiliary verbs are Defective, and are thus classless

################## AUXILIARY VERBS
# Modals
## Frozen modals do not take any suffix [-UNFROZE]
LEXICON ModalVerbAux
முடி:முட{I}[UNFROZE]         # 'muti'        can
# fix ask about ventum, ventam and frozens
# fix read wagisha
# fix add Auxiliary suffix

# Aspectuals
LEXICON AspectVerbAux
# Class 4
விடு<vaux><perf>:விட{U}[Class4]          # 'vitu'        complete
# Class 7
இரு<vaux><vbser><hab>:இர{U}[Class7]     # 'iru'          be

################## TRANSITIVE VERBS
# Many verbs are paired between transitive and intransitive (marked as Paired)
# These may have slight variance, or be the same
# Special verbs, <vbdo>, <vbser> placed on top of class list
# Followed by paired, then unpaired
LEXICON TransVerbStem
# Class 1

## Special double causitive
செய்<vbdo><tv>:செய்[Class1a,WEAKDOUBCAUS]       # 'cei'         do

# Class 2
மேய்<v><tv>:மேய்[Class2]                        # 'mei'         graze
தா<v><tv>:த{AA}[Class2]                         # 'thaa'        give
அறி<v><tv>:அற{I}[Class2]                       # 'ari'         find out

# Class 3
பண்ணு<vbdo><tv>:பண்ண{U}[Class3]             # 'pannu'       do
திருத்து<v><tv>:திருத்த{U}[Class3]                 # 'thiruththu'  improve                 Paired
திருப்பு<v><tv>:திருப்ப{U}[Class3]                 # 'thiruppu'    turn                     Paired
சுருக்கு<v><tv>:சுருக்க{U}[Class3]                 # 'curukku'     shrink                   Paired
ஆட்டு<v><tv>:ஆட்ட{U}[Class3]                   # 'aattu'       swing                    Paired
உருக்கு<v><tv>:உருக்க{U}[Class3]                # 'urukku'      melt                     Paired
நிமிர்த்து<v><tv>:நிமிர்த்த{U}[Class3]             # 'nimirththu'  erect                     Paired
புரட்டு<v><tv>:புரட்ட{U}[Class3]                  # 'purattu'     roll over                Paired
ஏற்று<v><tv>:ஏற்ற{U}[Class3]                     # 'ettu'        reach                    Paired
எழுது<v><tv>:எழுத{U}[Class3,CAUSIRR2]           # 'ezhuthu'     write
விளக்கு<v><tv>:விளக்க{U}[Class3]                # 'vilakku'     explain
வாங்கு<v><tv>:வாங்க{U}[Class3]                 # 'vaanku'      buy
வேண்டு<v><tv>:வேண்ட{U}[Class3]               # 'veentu'      want
கட்டு<v><tv>:கட்ட{U}[Class3]                     # 'kattu'       tie
காட்டு<v><tv>:காட்ட{U}[Class3]                  # 'kaattu'      show
ஆக்கு<v><tv>:ஆக்க{U}[Class3]                   # 'aakku'       make

## Special passive forms
ஒட்டு<v><tv>:ஒட்ட{U}[Class3,PASSIVE]             # 'ottu'        paste                    Paired
வெட்டு<v><tv>:வெட்ட{U}[Class3,PASSIVE]         # 'vettu'       cut
தட்டு<v><tv>:தட்ட{U}[Class3,PASSIVE]             # 'thattu'      knock
கொட்டு<v><tv>:கொட்ட{U}[Class3,PASSIVE]       # 'kottu'       pour
ஊற்று<v><tv>:ஊற்ற{U}[Class3,PASSIVE]          # 'uurru'       pour
பூட்டு<v><tv>:பூட்ட{U}[Class3,PASSIVE]            # 'puuttu'      lock

## Special double causitive
தேடு<v><tv>:தேட{U}[Class3,WEAKDOUBCAUS]        # 'theetu'      search

# Class 4
விளங்கு<v><tv>:விளங்க{U}[Class4]               # 'vilanku'     understand
விடு<v><tv>:விட{U}[Class4]                       # 'vitu'        leave
கூப்பிடு<v><tv>:கூப்பிட{U}[Class4]                # 'kuuppitu'    call

# Class 5
உண்<v><tv>:உண{Pul}[Class5]                  # 'un'          eat
சொல்<v><tv>:சொல{Pul}[Class5]                # 'col'         tell

# Class 6
முடி<v><tv>:முட{I}[Class6]                      # 'muti'        complete                   Paired
எடு<v><tv>:எட{U}[Class6]                        # 'etu'         take
கொடு<v><tv>:கொட{U}[Class6]                  # 'kotu'        give
அடி<v><tv>:அட{I}[Class6]                       # 'ati'         beat
சமை<v><tv>:சம{AI}[Class6]                     # 'chamai'      cook
பிடி<v><tv>:பிட{I}[Class6]                       # 'piti'        catch
பார்<v><tv>:பார{Pul}[Class6]                    # 'paar'        see

# Class 7
வை<v><tv>:வ{AI}[Class7]                        # 'vay'         place

################## INTRANSITIVE VERBS
LEXICON IntraVerbStem
# Class 1
பிரள்<v><iv>:பிரள{Pul}                           # 'piral'       roll over                Paired

## Special causitive form
அழு<v><iv>:அழ{U}[Class1a,INTRACAUS]            # 'azhu'        cry

# Class 2
நிமிர்<v><iv>:நிமிர{Pul}[Class2]                  # 'nimir'       erect                    Paired
வா<v><iv>:வ{AA}[Class2]                         # 'vaa'         come 
நனை<v><iv>:நன{AI}[Class2]                    # 'nanay'       wet

# Class 3
ஒட்டு<v><iv>:ஒட்ட{U}[Class3]                     # 'ottu'        adhere                  Paired
திரும்பு<v><iv>:திரும்ப{U}[Class3]                 # 'thirumpu'    turn                    Paired
பேசு<v><iv>:பேச{U}[Class3]                      # 'peecu'       speak
போ<v><iv>:போ[Class3]                          # 'poo'         go

## Special passive form
வாடு<v><iv>:வாட{U}[Class3,PASSIVE]             # 'vaatu'       wither

## Special causitive form
ஏறு<v><iv>:ஏற{U}[Class3,INTRACAUS]              # 'eeru'        climb                    Paired

# Class 4
திருந்து<v><iv>:திருந்த{U}[Class4]                # 'thirunthu'   improve                  Paired
சுருங்கு<v><iv>:சுருங்க{U}[Class4]                # 'curunku'     shrink                   Paired
ஆடு<v><iv>:ஆட{U}[Class4]                      # 'aatu'        swing                    Paired
உருகு<v><iv>:உருக{U}[Class4]                   # 'uruku'       melt                     Paired
முடி<v><iv>:முட{I}[Class4]                      # 'muti'        complete                 Paired
பிடி<v><iv>:பிட{I}[Class4]                       # 'piti'        like
தெரி<v><iv>:தெர{I}[Class4]                     # 'theri'       know
புரி<v><iv>:புர{I}[Class4]                        # 'puri'        understand

# Class 6
வலி<v><iv>:வல{I}[Class6]                       # 'vali'        ache
கிடை<v><iv>:கிட{AI}[Class6]                    # 'kitay'       be available

# Class 7
இரு<vbser><iv>:இர{U}[Class7]                   # 'iru'          be

## Special irregular causitive form
இரு<v><iv>:இர{U}[Class7,CAUSIRR1]              # 'iru'          sit/stay

### Special double causitive
நட<v><iv>:நட[Class7,CAUSIRR1,STRONGDOUBCAUS]   # 'nata'         walk

################################     ADJECTIVES     ################################
LEXICON Adjectives
நல்ல:நல்ல                 # 'nalla'       good
உச்சி:உச்சி                # 'ucci'         top
பெரிய:பெரி{Y}            # 'periya'       big
மாதிரி:மாதிரி             # 'maathiri'     like

################################     ADVERBS     ################################
LEXICON Adverbs
# Intensive
மாதிரி:மாதிரி             # 'maathiri'     like
சரியான:சரியான         # 'cariyaana'    very
ரொம்ப:ரொம்ப           # 'rompa'        very         Dir/LR
# Temporal
இன்னும்:இன்னும்         # 'innum'         yet

################################     DETERMINERS     ################################
LEXICON Determiners
ஒரு<det><ind>:ஒரு           # 'oru'     a

################################     COMPARATIVES     ################################
LEXICON Comparatives
# Comparison
விட<post><comp>:விட                         # 'vita'        than
காட்டிலும்<post><comp>:காட்டிலும{Pul}       # 'kaattilum'   than
பார்க்க<post><comp>:பார்க்க                  # 'paarkka'     than
பார்க்கிலும்<post><comp>:பார்க்கிலும{Pul}    # 'paarkkilum'  than
# Equatives
பூலே<post><eq>:பூலே                        # 'poolay~ai"   like

################################     POSTPOSITIONS     ################################
LEXICON PostPositions
# following a Nominative
செண்டு:செண்டு                # 'centu'       together
மூலம்:மூலம்                    # 'muulam'      through
வரை:வரை                     # 'varay'       upto
வரைக்கும்:வரைக்கும்           # 'varaykkum'   until
வரைலை:வரைலை             # 'varayilay'   at about

# following an Accusative
சுற்றி:சுற்றி                     # 'curri'       around
பற்றி:பற்றி                     # 'parri'       about
தவிர:தவிர                     # 'thavira'     except for

# following a Dative
மேலே:மேலே                   # 'meelee'              above
கீழே:கீழே                      # 'kiizhay'             beneath
முன்னாலே:முன்னாலே         # 'munnaalee'           before
முன்னுக்கு:முன்னுக்கு           # 'munnukku'           before            Dir/LR
பின்னாலே:பின்னாலே          # 'pinnaalee'           after
பின்னுக்கு:முன்னுக்கு           # 'pinnukku'            after             Dir/LR
உள்ளே:உள்ளே                 # 'ullee'               inside
பக்கத்திலே:பக்கத்திலே         # 'pakkattilee'        nearby
எதிரே:எதிரே                   # 'etiree'              opposite
அடியிலே:அடியிலே             # 'atiyilee'            at the bottom of

################################     NUMBERS     ################################
PATTERN Numbers
Numeral [ <num>: ]
NumStems [ <num>: ]

LEXICON NumStems
ஒன்று:ஒன்று            # 'onru'        one
ஒரு:ஒரு                 # 'oru'         one         Dir/LR
இரண்டு:இரண்டு        # 'irandu'      two
ரெண்டு:ரெண்டு         # 'rendu'       two         Dir/LR

LEXICON Numeral
# Latin
/([0123456789])+/
/([0123456789])+[.,]([0123456789])+/
# Tamil
/([௦௧௨௩௪௫௬௭௮௯௰௱௲])+/
/([௦௧௨௩௪௫௬௭௮௯])+[.,]([௦௧௨௩௪௫௬௭௮௯])+/

################################     SYMBOLS     ################################
PATTERN Symbol
Symbols [<sym>:]

LEXICON Symbols
௳:௳         # day
௴:௴        # month	
௵:௵    # year
௶:௶        # debit
௷:௷       # credit
௸:௸     # as above
௹:௹        # rupee
௺:௺         # numeral
ள:ள        # time
வ:வ        # quantity
𑿮:𑿮       # in possession
𑿯:𑿯       # starting from
𑿰:𑿰       # et cetera (items in series)
𑿱:𑿱      # et cetera (items of family or kind)


# Old currency units
𑿝:𑿝        # small unit
𑿞:𑿞        # gold coin
𑿟:𑿟       # gold coin                   Dir/LR
𑿠:𑿠       # gold coin with insignia

# Agricultural symbols
𑿤:𑿤       # wet cultivation
𑿥:𑿥       # dry cultivation
𑿦:𑿦       # land
𑿧:𑿧       # salt pan

# Clerical symbols
𑿨:𑿨       # old credit symbol
𑿩:𑿩        # old numeral symbol
𑿪:𑿪       # current
𑿫:𑿫       # and odd
𑿬:𑿬        # spent
𑿭:𑿭      # total

################################     FRACTIONS     ################################
PATTERN Fraction
Fractions [<num>:]

LEXICON Fractions
𑿀:𑿀          # 1/320
𑿁:𑿁	           # 1/160
𑿂:𑿂               # 1/80
𑿃:𑿃            # 1/64
𑿄:𑿄             # 1/40
𑿅:𑿅            # 1/32
𑿆:𑿆            # 3/8
𑿇:𑿇            # 3/64
𑿈:𑿈              # 1/20
𑿉:𑿉            # 1/16
𑿊:𑿊            # 1/16         Dir/LR
𑿋:𑿋              # 1/10
𑿌:𑿌          # 1/8
𑿍:𑿍             # 3/20
𑿎:𑿎           # 3/16
𑿏:𑿏             # 1/5
𑿐:𑿐             # 1/4
𑿑:𑿑               # 1/2
𑿒:𑿒             # 1/2           Dir/LR
𑿓:𑿓            # 3/4
𑿔:𑿔             # Downscaling factor

################################     MEASURES     ################################
PATTERN Measure
Measures [<num>:]

LEXICON Measures
𑿕:𑿕           # one grain of paddy
𑿖:𑿖           # 360 𑿕
𑿗:𑿗           # 5 𑿖
𑿘:𑿘           # 2 𑿗
𑿙:𑿙          # 3 𑿘
உரி:உரி        # 2 𑿘
௳:௳            # 2 உரி 
𑿚:𑿚             # 8 ௳
ங:ங            # 8 ௳                   Dir/LR
𑿛:𑿛          # 2 𑿚
𑿜:𑿜           # 3 𑿚
த:த             # 2 𑿛
ள:ள            # 3 த

# Weights
𑿡:𑿡          # 500 lbs
𑿢:𑿢         # 11 sq. feet
𑿣:𑿣         # 22,000 sq. feet

################################     PUNCTUATION     ################################
LEXICON Punctuation

𑿿<sent>:𑿿       # end of text punctuation
.<sent>:.
..<sent>:..
...<sent>:...
;<sent>:;
\:<sent>:\:
!<sent>:!
-<guio>:-
—<guio>:—
,<cm>:,
